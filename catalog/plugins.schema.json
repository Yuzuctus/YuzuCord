{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yuzuctus/YuzuCord/blob/main/catalog/plugins.schema.json",
  "title": "YuzuCord plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/safePath" },
        "to": { "$ref": "#/$defs/safePath" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "reviewedAt"],
      "properties": {
        "approvedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "localSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "repository"],
      "properties": {
        "type": { "const": "local" },
        "path": { "$ref": "#/$defs/safePath" },
        "repository": { "type": "string", "pattern": "^https://" }
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "commit", "integrity", "review"],
      "properties": {
        "type": { "const": "git" },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "integrity": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "source",
        "mappings",
        "entrypoint",
        "settingsKey",
        "provenance",
        "dependencies",
        "conflicts",
        "license",
        "licenseFile",
        "maintainer",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "source": { "oneOf": [{ "$ref": "#/$defs/localSource" }, { "$ref": "#/$defs/gitSource" }] },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mapping" }
        },
        "entrypoint": { "$ref": "#/$defs/safePath" },
        "settingsKey": { "type": "string" },
        "provenance": {
          "type": "string",
          "enum": ["yuzuctus", "thirdParty"]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "license": { "type": "string", "minLength": 1 },
        "licenseFile": { "$ref": "#/$defs/safePath" },
        "maintainer": { "type": "string", "minLength": 1 },
        "status": { "enum": ["maintained", "beta", "experimental", "deprecated"] }
      }
    }
  }
}
