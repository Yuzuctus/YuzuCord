<Window x:Class="RandomFavorites.Setup.Dialogs.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Désinstaller YuzuCord"
        Width="500" Height="530"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        AutomationProperties.Name="Options de désinstallation"
        PreviewKeyDown="Dialog_OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1" CornerRadius="10" Padding="24,0,16,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Désinstaller" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleBarButton}"
                    AutomationProperties.Name="Fermer" Click="CancelButton_OnClick">
                <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource CloseGeometry}" />
            </Button>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,8,12">
                <StackPanel>
                    <TextBlock Text="Choisissez précisément ce qui doit être retiré. Aucun autre fichier ne sera supprimé."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <RadioButton x:Name="PluginOnlyRadio" IsChecked="True"
                                 Content="Retirer les _plugins gérés uniquement"
                                 Checked="Selection_OnChanged" />
                    <TextBlock Text="Vencord officiel et ses autres réglages seront conservés."
                               Style="{StaticResource SecondaryText}" Margin="32,-2,0,6" TextWrapping="Wrap" />
                    <CheckBox x:Name="RemovePluginSettingsCheck" Margin="32,0,0,4"
                              Content="Supprimer aussi les _réglages des plugins gérés" />

                    <RadioButton x:Name="VencordKeepDataRadio"
                                 Content="Retirer _Vencord, conserver ses réglages"
                                 Checked="Selection_OnChanged" />
                    <RadioButton x:Name="VencordRemoveDataRadio"
                                 Content="Retirer Vencord et ses réglages _locaux"
                                 Foreground="{StaticResource Error}"
                                 Checked="Selection_OnChanged" />
                    <CheckBox x:Name="DeleteDataAcknowledge" Visibility="Collapsed"
                              Margin="32,0,0,4"
                              Content="Je _confirme la suppression des données locales"
                              Checked="Selection_OnChanged" Unchecked="Selection_OnChanged" />

                    <CheckBox x:Name="RemoveOpenAsarCheck" Visibility="Collapsed"
                              Margin="0,10,0,0" Content="Retirer également _OpenAsar"
                              Checked="Selection_OnChanged" Unchecked="Selection_OnChanged" />

                    <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                            Background="{StaticResource WarningSurface}"
                            BorderBrush="{StaticResource Warning}" BorderThickness="1">
                        <TextBlock x:Name="ExplanationText"
                                   Text="Les plugins gérés seront retirés. Vencord et ses réglages seront conservés."
                                   Foreground="{StaticResource TextPrimary}" FontSize="14"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="_Annuler" Style="{StaticResource QuietButton}"
                        Margin="0,0,8,0" Click="CancelButton_OnClick" />
                <Button x:Name="ConfirmButton" Content="_Désinstaller"
                        Style="{StaticResource DangerButton}" MinWidth="124"
                        IsDefault="True" Click="ConfirmButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
