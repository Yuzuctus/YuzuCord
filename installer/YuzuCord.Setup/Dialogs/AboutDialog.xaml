<Window x:Class="YuzuCord.Setup.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de YuzuCord"
        Width="520" Height="350"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        AutomationProperties.Name="À propos de YuzuCord"
        PreviewKeyDown="Dialog_OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1" CornerRadius="10">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Margin="16,0,0,0">
                <TextBlock Text="À propos" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleBarButton}"
                        AutomationProperties.Name="Fermer" Click="CloseButton_OnClick">
                    <Path Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Data="{StaticResource CloseGeometry}" />
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{StaticResource BorderSubtle}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="178" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="28,25,24,20" VerticalAlignment="Center">
                    <TextBlock Text="YUZUCORD" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Discord, à ta façon." FontSize="24" FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="VersionText" Text="Version —"
                               Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    <TextBlock Margin="0,17,0,0" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Text="Une build Vencord vérifiée, tes plugins gérés et OpenAsar en option. Sans télémétrie et sans accès à ton jeton Discord." />
                    <TextBlock Text="Illustration · KouriHase"
                               Style="{StaticResource QuietText}" Margin="0,13,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource ArtworkSurface}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
                    <Grid ClipToBounds="True">
                        <Image Width="230" Margin="-35,18,-38,-32"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False">
                            <Image.Source>
                                <BitmapImage UriSource="../Assets/Artwork/YuzuChibiHello.png"
                                             DecodePixelWidth="300" CacheOption="OnLoad" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Button Content="Projet _GitHub" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Click="GitHubButton_OnClick" />
                    <Button x:Name="CloseButton" Content="_Fermer"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" MinWidth="96"
                            IsDefault="True" Click="CloseButton_OnClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
