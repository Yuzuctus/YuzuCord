<Window x:Class="YuzuCord.Setup.Dialogs.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation"
        Width="460" Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        AutomationProperties.Name="Confirmation"
        PreviewKeyDown="Dialog_OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>
            <Grid Margin="16,0,0,0">
                <TextBlock Text="Confirmation" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleBarButton}"
                        AutomationProperties.Name="Fermer" Click="CancelButton_OnClick">
                    <Path Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Data="{StaticResource CloseGeometry}" />
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{StaticResource BorderSubtle}" />
            <Grid Grid.Row="1" Margin="26,22,26,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="2" Background="{StaticResource Accent}" />
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Confirmer"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="CancelButton" Content="_Annuler"
                            Style="{StaticResource QuietButton}" Margin="0,0,6,0"
                            Click="CancelButton_OnClick" />
                    <Button x:Name="ConfirmButton" Content="_Confirmer"
                            Style="{StaticResource PrimaryButton}" MinWidth="124"
                            IsDefault="True" Click="ConfirmButton_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
